<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm">

  <xacro:property name="PI" value="3.14159265358979"/>

  <!-- Materials -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <!-- World Link -->
  <link name="world"/>

  <!-- BASE Link -->
  <link name="basement">
    <visual>
      <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/basement.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- World to Basement Joint -->
  <joint name="world_to_basement" type="fixed">
    <parent link="world"/>
    <child link="basement"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="-0.39 -0.39 -0.56"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_plate.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- Basement to Base Link Joint -->
  <joint name="basement_to_base_link" type="fixed">
    <parent link="basement"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>

  <!-- Base Plate -->
  <link name="base_plate">
    <visual>
      <origin rpy="0 0 0" xyz="-0.39 -0.39 -0.56"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/round_plate.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Base Link to Base Plate Joint -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="base_plate"/>
    <origin rpy="0 0 0" xyz="0 0 0.04"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <!-- Forward Drive Arm -->
  <link name="forward_drive_arm">
    <visual>
      <origin rpy="0 -${PI/2} ${PI/2}" xyz="0.19 0.06 -0.08"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/forward_drive_arm.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- Base Plate to Forward Drive Arm Joint -->
  <joint name="joint2" type="revolute">
    <parent link="base_plate"/>
    <child link="forward_drive_arm"/>
    <origin rpy="0 0 0" xyz="0 0 0.04"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>

  <!-- Horizontal Arm -->
  <link name="horizontal_arm">
    <visual>
      <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 -0.4 -0.06"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/horizontal_arm.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.2 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <!-- Forward Drive Arm to Horizontal Arm Joint -->
  <joint name="joint3" type="revolute">
    <parent link="forward_drive_arm"/>
    <child link="horizontal_arm"/>
    <origin rpy="0 0 0" xyz="0 0 0.2"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>

  <!-- Claw Support -->
  <link name="claw_support">
    <visual>
      <origin rpy="0 0 ${PI/2}" xyz="0 -0.05 -0.15"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/claw_support.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Horizontal Arm to Claw Support Joint -->
  <joint name="joint4" type="revolute">
    <parent link="horizontal_arm"/>
    <child link="claw_support"/>
    <origin rpy="0 0 0" xyz="0.15 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>

  <!-- Gripper Right -->
  <link name="gripper_right">
    <visual>
      <origin rpy="0 0 -${PI/2}" xyz="-0.1 0.5 -0.1"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/right_finger.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Claw Support to Gripper Right Joint -->
  <joint name="joint5" type="prismatic">
    <parent link="claw_support"/>
    <child link="gripper_right"/>
    <origin rpy="0 0 0" xyz="0 0 -0.1"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="0" upper="0.08" velocity="0.5"/>
  </joint>

  <!-- Gripper Left -->
  <link name="gripper_left">
    <visual>
      <origin rpy="0 0 -${PI/2}" xyz="-0.04 0.5 -0.1"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/left_finger.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Claw Support to Gripper Left Joint -->
  <joint name="joint6" type="prismatic">
    <parent link="claw_support"/>
    <child link="gripper_left"/>
    <origin rpy="0 0 0" xyz="0 0 -0.1"/>
    <axis xyz="-1 0 0"/>
    <limit effort="100" lower="0" upper="0.08" velocity="0.5"/>
   <!--  <mimic joint="joint4" multiplier="-1"/> -->
  </joint>

</robot>
